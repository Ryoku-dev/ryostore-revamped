#!/usr/bin/env bash
set -euo pipefail

item_dir=${RYOKU_ITEM_DIR:?RYOKU_ITEM_DIR is required}
[[ ${RYOKU_ITEM_ID:-nomarchy} == nomarchy ]] || {
  printf 'nomarchy activate: unexpected item id %s\n' "${RYOKU_ITEM_ID:-}" >&2
  exit 1
}
[[ -d $item_dir/qml && -d $item_dir/bin ]] || {
  printf 'nomarchy activate: incomplete item at %s\n' "$item_dir" >&2
  exit 1
}

data_home=${XDG_DATA_HOME:-$HOME/.local/share}
state_home=${XDG_STATE_HOME:-$HOME/.local/state}
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
cache_home=${XDG_CACHE_HOME:-$HOME/.cache}
local_bin=${XDG_BIN_HOME:-$HOME/.local/bin}
runtime_home=${XDG_RUNTIME_DIR:-$state_home/ryoku/runtime}
root=$data_home/ryoku/nomarchy
check=0
[[ ${1:-} == --check ]] && check=1

home_real=$(realpath -m -- "$HOME")
within_home() {
  local path_real
  path_real=$(realpath -m -- "$1")
  [[ $path_real == "$home_real" || $path_real == "$home_real"/* ]]
}

for path in "$data_home" "$state_home" "$config_home" "$cache_home" "$local_bin"; do
  within_home "$path" || {
    printf 'nomarchy activate: refusing to write outside HOME: %s\n' "$path" >&2
    exit 1
  }
done

link_is() {
  [[ -L $1 && $(readlink -- "$1") == "$2" ]]
}

need_link() {
  local target=$1 link=$2
  if link_is "$link" "$target"; then
    return 0
  fi
  (( check )) && return 1
  if [[ -L $link ]]; then
    rm -f -- "$link"
  elif [[ -e $link ]]; then
    printf 'nomarchy activate: refusing to replace %s\n' "$link" >&2
    return 1
  fi
  ln -s -- "$target" "$link"
}

if (( ! check )); then
  mkdir -p "$root" "$root/shell" "$local_bin" "$config_home/omarchy/plugins" "$runtime_home"
fi

# OMARCHY_PATH keeps Omarchy's own layout; every entry points back into this item.
need_link "$item_dir/bin" "$root/bin" || exit 1
for name in config default themes; do
  need_link "$item_dir/data/$name" "$root/$name" || exit 1
done
need_link "$item_dir/qml/Host.qml" "$root/shell/shell.qml" || exit 1
for name in services plugins; do
  need_link "$item_dir/qml/$name" "$root/shell/$name" || exit 1
done
for name in Commons Ui; do
  need_link "$item_dir/qml/nomarchy/$name" "$root/shell/$name" || exit 1
done

if (( check )); then
  [[ -d $config_home/omarchy/plugins && -f $config_home/omarchy/shell.json ]] || exit 1
  [[ -f $state_home/omarchy/current/theme/colors.toml && -f $state_home/omarchy/current/theme/shell.toml ]] || exit 1
else
  if [[ ! -f $config_home/omarchy/shell.json ]]; then
    install -m0644 "$item_dir/data/config/omarchy/shell.json" "$config_home/omarchy/shell.json"
  fi
  if [[ ! -f $state_home/omarchy/current/theme/colors.toml || ! -f $state_home/omarchy/current/theme/shell.toml ]]; then
    theme=$(cat "$config_home/omarchy/current-theme" 2>/dev/null || printf 'ryoku\n')
    if [[ $theme == ryoku && ! -f $cache_home/ryoku/nomarchy-colors.toml && -f $cache_home/ryoku/colors.json ]]; then
      "$item_dir/bin/palette" "$cache_home/ryoku/colors.json"
    else
      PATH=$item_dir/bin:$PATH OMARCHY_PATH=$root XDG_RUNTIME_DIR=$runtime_home "$item_dir/bin/omarchy-theme-set" "$theme"
    fi
  fi
fi

conflict=0
for helper in "$item_dir/bin"/omarchy "$item_dir/bin"/omarchy-shell "$item_dir/bin"/omarchy-*; do
  [[ -e $helper || -L $helper ]] || continue
  name=${helper##*/}
  target=$root/bin/$name
  link=$local_bin/$name
  if link_is "$link" "$target"; then
    continue
  fi
  if (( check )); then
    exit 1
  fi
  if [[ -e $link || -L $link ]]; then
    if [[ -L $link && $(readlink -- "$link") == "$root/bin/"* ]]; then
      rm -f -- "$link"
    else
      printf 'nomarchy activate: keeping non-Ryoku command %s\n' "$link" >&2
      conflict=1
      continue
    fi
  fi
  ln -s -- "$target" "$link"
done

(( conflict == 0 ))